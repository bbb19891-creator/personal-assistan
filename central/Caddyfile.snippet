# Add this block to the Caddyfile after the DNS A record exists, then validate and reload Caddy.
# If Caddy runs in a container, set CADDY_CONTAINER (example: caddy):
#   docker exec "$CADDY_CONTAINER" caddy validate --config /etc/caddy/Caddyfile
#   docker exec "$CADDY_CONTAINER" caddy reload --config /etc/caddy/Caddyfile
# Upstream is ONBOARD_BIND:ONBOARD_PORT. Example values live in agent-onboarding.service.
__ONBOARD_HOST__ {
	encode gzip
	reverse_proxy __ONBOARD_BIND__:__ONBOARD_PORT__
}
