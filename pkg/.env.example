# ===== Assistant configuration (/opt/agent/.env, chmod 600). The setup page fills most of this for you. =====
# --- identity (setup page, step 1) ---
BOT_NAME=
OWNER_NAME=
# owner WhatsApp number, international digits without + (e.g. 9725XXXXXXXX)
OWNER_PHONE=
# optional second owner (spouse/partner) with the same permissions
PARTNER_NAME=
PARTNER_PHONE=
# optional more owners: name:phone,name:phone
EXTRA_OWNERS=
# optional kids for weekend planning / activities: name:YYYY-MM-DD,name:YYYY-MM-DD
KIDS=
TIMEZONE=Asia/Jerusalem
HOME_AREA=
WEATHER_CITY=
PHONE_COUNTRY_CODE=972
# names the bot answers to in groups (comma separated); setup page sets it to BOT_NAME
WA_BOT_NAMES=

# --- OpenAI (setup page, step 3) ---
OPENAI_API_KEY=
MAIN_MODEL=gpt-6-sol
VISION_MODEL=gpt-6.1-sol
WEB_SEARCH_MODEL=gpt-6-sol
CHEAP_MODEL=gpt-6-luna
TOOLS_FALLBACK_MODEL=gpt-6-sol
# monthly spending stop in USD (0 = no limit)
COST_CEILING_USD=30

# --- Google (setup page, step 4): your OWN OAuth client ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# desktop = paste flow (works everywhere); web = redirect to PUBLIC_BASE_URL/google/callback
GOOGLE_CLIENT_TYPE=desktop
# optional: lock the main/work account to a specific address
GOOGLE_PERSONAL_EMAIL=
GOOGLE_WORK_EMAIL=
# optional: your own addresses (comma separated) - never treated as "external" invitees
OWNER_EMAILS=
# optional: always add this address to calendar invites
OWNER_INVITE_EMAIL=
DRIVE_ARCHIVE_ACCOUNT=personal

# --- WhatsApp bridge (install.sh fills these) ---
WA_ENABLED=1
WA_BRIDGE_URL=http://127.0.0.1:8795
WA_BRIDGE_TOKEN=
WA_INBOUND_PORT=8794
# extra allowed numbers/groups (comma separated); owners are always allowed
WA_ALLOWED=
WA_OPEN_MODE=0
# optional special groups (JID ...@g.us): family group is auto-detected when owner + partner are both in it
WA_FAMILY_GROUP=
WA_TASKS_GROUP=
WA_INVOICES_GROUP=
PUBLIC_BASE_URL=

# --- features ---
# 0 = no scheduled messages (morning brief, weekend plan, bills scan, ...)
FAMILY_SCHED_ENABLED=1
# 1 = log scheduled sends instead of sending (testing)
FAMILY_DRY_RUN=0
SCHED_BRIEF=07:30
SCHED_WEEKEND=17:00

# --- optional extras ---
SERPER_API_KEY=
FIRECRAWL_KEY=
GOOGLE_PLACES_API_KEY=
TELEGRAM_TOKEN=
