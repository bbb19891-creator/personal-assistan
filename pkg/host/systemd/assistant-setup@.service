[Unit]
Description=Assistant bot %i - setup / connections page
After=network-online.target

[Service]
User=agent-%i
Group=agent-%i
WorkingDirectory=/opt/agents/_shared/agent
Environment=AGENT_HOME=/opt/agents/%i
EnvironmentFile=/opt/agents/%i/setup.env
ExecStart=/opt/agents/_shared/venv/bin/python /opt/agents/_shared/agent/setup_web.py
Restart=always
RestartSec=5
MemoryMax=150M
CPUQuota=25%
StandardOutput=append:/opt/agents/%i/logs/setup.log
StandardError=append:/opt/agents/%i/logs/setup.log
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/agents/%i
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
